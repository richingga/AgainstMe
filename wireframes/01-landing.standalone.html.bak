      'pill-tobacco': 'Rokok',
      'pill-gambling': 'Judi',
      'pill-pmo': 'PMO',
      'pill-alcohol': 'Alkohol',
      'pill-drugs': 'Narkoba',
      'val-title': 'Semua yang kamu butuhkan untuk tetap kuat',
      'val-sub': 'Alat sederhana yang benar-benar membantu — tanpa rasa bersalah, tanpa penghakiman.',
      'v1-title': 'Streak Counter',
      'v1-desc': 'Lihat harimu bertambah. Setiap detik berarti — dan kamu bisa lihat langsung.',
      'v2-title': 'Uang Dihemat',
      'v2-desc': 'Lihat berapa banyak yang sudah kamu hemat. Tetapkan target — PS5 itu makin dekat.',
