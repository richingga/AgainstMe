<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>AgainstMe — Quit Addiction</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --cream: #FFF8F0;
    --cream-dark: #F5EDE3;
    --sand: #EDE4D8;
    --terracotta: #C4654A;
    --terracotta-hover: #B5573D;
    --terracotta-light: rgba(196,101,74,0.08);
    --amber: #D4913A;
    --sage: #7A9E7E;
    --sage-light: rgba(122,158,126,0.12);
    --teal: #5B8F8C;
    --charcoal: #3D3530;
    --brown: #5C4F47;
    --brown-muted: #8C7E74;
    --brown-light: #B0A296;
    --white: #FFFFFF;
    --shadow-sm: 0 1px 3px rgba(61,53,48,0.06);
    --shadow-md: 0 4px 16px rgba(61,53,48,0.08);
    --shadow-lg: 0 8px 32px rgba(61,53,48,0.12);
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 20px;
    --radius-xl: 28px;
    --font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: var(--font);
    background: var(--cream);
    color: var(--charcoal);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  /* ===== NAV ===== */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255,248,240,0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(61,53,48,0.06);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--charcoal);
  }

  .logo-icon {
    width: 32px;
    height: 32px;
    background: var(--terracotta);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    font-weight: 800;
    font-size: 16px;
  }

  .logo-text {
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.3px;
  }

  .logo-text span { color: var(--terracotta); }

  .nav-lang {
    display: flex;
    align-items: center;
    gap: 4px;
    background: var(--sand);
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    color: var(--brown);
    cursor: pointer;
    border: none;
    transition: background 0.2s;
  }

  .nav-lang:hover { background: var(--cream-dark); }

  /* ===== HERO ===== */
  .hero {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 80px 20px 40px;
    position: relative;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -20%;
    right: -15%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(196,101,74,0.06) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    bottom: -10%;
    left: -10%;
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(122,158,126,0.06) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--sage-light);
    color: var(--sage);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 24px;
    letter-spacing: 0.2px;
  }

  .hero h1 {
    font-size: clamp(32px, 9vw, 56px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin-bottom: 16px;
    max-width: 700px;
    color: var(--charcoal);
  }

  .hero h1 .highlight {
    color: var(--terracotta);
    position: relative;
  }

  .hero h1 .highlight::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 0;
    right: 0;
    height: 5px;
    background: rgba(196,101,74,0.15);
    border-radius: 3px;
  }

  .hero-sub {
    font-size: clamp(15px, 3.5vw, 18px);
    color: var(--brown-muted);
    max-width: 380px;
    line-height: 1.6;
    margin-bottom: 32px;
    font-weight: 400;
    padding: 0 8px;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--terracotta);
    color: var(--white);
    padding: 16px 36px;
    border-radius: var(--radius-xl);
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 4px 20px rgba(196,101,74,0.3);
    letter-spacing: 0.2px;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    min-height: 52px;
  }

  .hero-cta:hover {
    background: var(--terracotta-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 28px rgba(196,101,74,0.4);
  }

  .hero-cta:active {
    transform: translateY(0);
    box-shadow: 0 2px 12px rgba(196,101,74,0.3);
  }

  .hero-cta svg {
    width: 18px;
    height: 18px;
    transition: transform 0.2s;
  }

  .hero-cta:hover svg { transform: translateX(3px); }

  .hero-note {
    margin-top: 14px;
    font-size: 12px;
    color: var(--brown-light);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* ===== ADDICTION PILLS ===== */
  .addictions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 36px;
    max-width: 360px;
    padding: 0 8px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0;
    background: var(--white);
    border: 1px solid var(--sand);
    padding: 8px 16px;
    border-radius: 40px;
    font-size: 13px;
    font-weight: 500;
    color: var(--brown);
    transition: all 0.2s;
    cursor: default;
    -webkit-tap-highlight-color: transparent;
  }

  .pill:hover {
    border-color: var(--terracotta);
    color: var(--terracotta);
    background: var(--terracotta-light);
  }

  /* ===== VALUE PROPS ===== */
  .values {
    padding: 60px 20px;
    max-width: 900px;
    margin: 0 auto;
  }

  .values-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .values-header h2 {
    font-size: clamp(22px, 6vw, 32px);
    font-weight: 800;
    letter-spacing: -0.8px;
    margin-bottom: 10px;
  }

  .values-header p {
    font-size: 14px;
    color: var(--brown-muted);
    max-width: 340px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .value-card {
    background: var(--white);
    border: 1px solid rgba(61,53,48,0.06);
    border-radius: var(--radius-lg);
    padding: 20px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
    transition: all 0.25s;
  }

  .value-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .value-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .value-icon.fire { background: rgba(196,101,74,0.1); }
  .value-icon.money { background: rgba(212,145,58,0.1); }
  .value-icon.sos { background: rgba(196,101,74,0.1); }
  .value-icon.ai { background: rgba(122,158,126,0.1); }

  .value-icon svg {
    width: 22px;
    height: 22px;
  }

  .value-content h3 {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 4px;
    letter-spacing: -0.2px;
  }

  .value-content p {
    font-size: 13px;
    color: var(--brown-muted);
    line-height: 1.5;
  }

  /* ===== PREVIEW PHONE ===== */
  .preview {
    padding: 32px 20px 60px;
    display: flex;
    justify-content: center;
  }

  .phone-frame {
    width: 100%;
    max-width: 320px;
    background: var(--white);
    border-radius: 28px;
    padding: 20px;
    box-shadow: var(--shadow-lg);
    border: 1px solid rgba(61,53,48,0.06);
  }

  .phone-status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    font-weight: 600;
    color: var(--brown-muted);
    margin-bottom: 20px;
    padding: 0 4px;
  }

  .phone-greeting {
    font-size: 14px;
    color: var(--brown-muted);
    margin-bottom: 4px;
  }

  .phone-name {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
    margin-bottom: 20px;
  }

  .phone-streak {
    background: linear-gradient(135deg, var(--terracotta), #D4744A);
    border-radius: var(--radius-lg);
    padding: 24px;
    color: var(--white);
    text-align: center;
    margin-bottom: 12px;
  }

  .phone-streak-days {
    font-size: 42px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1;
  }

  .phone-streak-label {
    font-size: 11px;
    font-weight: 500;
    opacity: 0.85;
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .phone-saved {
    background: rgba(212,145,58,0.08);
    border-radius: var(--radius-md);
    padding: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .phone-saved-icon {
    width: 36px;
    height: 36px;
    background: rgba(212,145,58,0.12);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .phone-saved-icon svg {
    width: 18px;
    height: 18px;
    stroke: var(--amber);
  }

  .phone-saved-text {
    font-size: 11px;
    color: var(--brown-muted);
  }

  .phone-saved-amount {
    font-size: 18px;
    font-weight: 700;
    color: var(--amber);
    letter-spacing: -0.3px;
  }

  .phone-sos {
    background: var(--terracotta-light);
    border: 2px dashed rgba(196,101,74,0.3);
    border-radius: var(--radius-md);
    padding: 14px;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--terracotta);
    cursor: pointer;
    transition: all 0.2s;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .phone-sos:hover {
    background: rgba(196,101,74,0.15);
    border-color: var(--terracotta);
  }

  /* ===== FOOTER ===== */
  .footer {
    text-align: center;
    padding: 32px 20px;
    border-top: 1px solid var(--sand);
  }

  .footer-tagline {
    font-size: 16px;
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: 8px;
    letter-spacing: -0.3px;
    font-style: italic;
  }

  .footer-copy {
    font-size: 12px;
    color: var(--brown-light);
  }

  /* ===== RESPONSIVE ===== */
  @media (min-width: 480px) {
    .addictions { max-width: 440px; }
    .hero-sub { max-width: 420px; }
  }

  @media (min-width: 640px) {
    .values-grid {
      grid-template-columns: 1fr 1fr;
    }
    nav { padding: 14px 24px; }
  }

  @media (min-width: 768px) {
    nav { padding: 16px 40px; }
    .logo-icon { width: 36px; height: 36px; font-size: 18px; }
    .logo-text { font-size: 18px; }
    .hero { padding: 120px 40px 80px; }
    .hero-sub { max-width: 480px; }
    .values { padding: 80px 40px; }
    .value-card { padding: 28px; gap: 20px; }
    .value-icon { width: 48px; height: 48px; }
    .value-content h3 { font-size: 17px; }
    .value-content p { font-size: 14px; }
  }

  /* ===== REDUCED MOTION ===== */
  @media (prefers-reduced-motion: reduce) {
    .hero-cta, .value-card, .pill { transition: none; }
    .hero-cta:hover, .value-card:hover { transform: none; }
  }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <a href="#" class="logo">
    <div class="logo-icon">A</div>
    <div class="logo-text">Against<span>Me</span></div>
  </a>
  <button class="nav-lang" onclick="toggleLang()">
    <span id="langLabel">EN</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
  </button>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-badge" data-i18n="hero-badge">Free and private — no account needed</div>

  <h1>
    <span data-i18n="hero-1">The fight is</span><br>
    <span class="highlight" data-i18n="hero-2">against me</span><span data-i18n="hero-3">,</span><br>
    <span data-i18n="hero-4">for me.</span>
  </h1>

  <p class="hero-sub" data-i18n="hero-sub">
    Track your streak, see the money you save, and get instant support when cravings hit — all in one calm space.
  </p>

  <button class="hero-cta" data-i18n="hero-cta">
    Start Free
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
  </button>

  <p class="hero-note">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    <span data-i18n="hero-note">No login required · Your data stays on your device</span>
  </p>

  <div class="addictions">
    <span class="pill" data-i18n="pill-tobacco">Tobacco</span>
    <span class="pill" data-i18n="pill-gambling">Gambling</span>
    <span class="pill" data-i18n="pill-pmo">PMO</span>
    <span class="pill" data-i18n="pill-alcohol">Alcohol</span>
    <span class="pill" data-i18n="pill-drugs">Drugs</span>
  </div>
</section>

<!-- VALUE PROPS -->
<section class="values">
  <div class="values-header">
    <h2 data-i18n="val-title">Everything you need to stay strong</h2>
    <p data-i18n="val-sub">Simple tools that actually help — no guilt, no judgment, just support.</p>
  </div>

  <div class="values-grid">
    <div class="value-card">
      <div class="value-icon fire">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--terracotta)" stroke-width="2" stroke-linecap="round"><path d="M12 12c-2-2.67-2-6.33 0-8 4 4.67 6 8.33 6 11a6 6 0 0 1-12 0c0-1.31.37-2.69 1-3.85A3.98 3.98 0 0 0 10 15a2 2 0 1 0 2-3z"/></svg>
      </div>
      <div class="value-content">
        <h3 data-i18n="v1-title">Streak Counter</h3>
        <p data-i18n="v1-desc">Watch your days grow. Every second counts — and you can see it live.</p>
      </div>
    </div>

    <div class="value-card">
      <div class="value-icon money">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v12M15 9.5c-.64-.89-1.64-1.5-3-1.5-2.21 0-3 1.34-3 2.5 0 2.5 6 1.25 6 4 0 1.34-1.21 2.5-3 2.5-1.55 0-2.64-.72-3.22-1.67"/></svg>
      </div>
      <div class="value-content">
        <h3 data-i18n="v2-title">Money Saved</h3>
        <p data-i18n="v2-desc">See exactly how much you've saved. Set a goal — that PS5 is getting closer.</p>
      </div>
    </div>

    <div class="value-card">
      <div class="value-icon sos">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--terracotta)" stroke-width="2" stroke-linecap="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7 7-7z"/></svg>
      </div>
      <div class="value-content">
        <h3 data-i18n="v3-title">SOS Craving</h3>
        <p data-i18n="v3-desc">One tap when the urge hits. Breathing guide, distraction, or talk to AI.</p>
      </div>
    </div>

    <div class="value-card">
      <div class="value-icon ai">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--sage)" stroke-width="2" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </div>
      <div class="value-content">
        <h3 data-i18n="v4-title">AI Companion</h3>
        <p data-i18n="v4-desc">A friend who never sleeps, never judges. Talk anytime — 2 AM included.</p>
      </div>
    </div>
  </div>
</section>

<!-- PHONE PREVIEW -->
<section class="preview">
  <div class="phone-frame">
    <div class="phone-status">
      <span>9:41</span>
      <span>AgainstMe</span>
    </div>
    <div class="phone-greeting" data-i18n="phone-greet">Good morning,</div>
    <div class="phone-name">Rizky</div>

    <div class="phone-streak">
      <div class="phone-streak-days" id="streakDays">47</div>
      <div class="phone-streak-label" data-i18n="phone-streak-label">days strong</div>
    </div>

    <div class="phone-saved">
      <div class="phone-saved-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v12M15 9.5c-.64-.89-1.64-1.5-3-1.5-2.21 0-3 1.34-3 2.5 0 2.5 6 1.25 6 4 0 1.34-1.21 2.5-3 2.5-1.55 0-2.64-.72-3.22-1.67"/></svg>
      </div>
      <div>
        <div class="phone-saved-text" data-i18n="phone-saved-label">Money saved</div>
        <div class="phone-saved-amount">Rp 1.316.000</div>
      </div>
    </div>

    <div class="phone-sos">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7 7-7z"/></svg>
      <span data-i18n="phone-sos">I'm struggling right now</span>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="footer">
  <p class="footer-tagline" data-i18n="footer-tagline">"The fight is against me, for me."</p>
  <p class="footer-copy">2026 AgainstMe</p>
</footer>

<script>
  const translations = {
    en: {
      'hero-1': 'The fight is',
      'hero-2': 'against me',
      'hero-3': ',',
      'hero-4': 'for me.',
      'hero-sub': 'Track your streak, see the money you save, and get instant support when cravings hit — all in one calm space.',
      'hero-cta': 'Start Free \u2192',
      'hero-note': 'No login required \u00b7 Your data stays on your device',
      'hero-badge': 'Free and private — no account needed',
      'pill-tobacco': 'Tobacco',
      'pill-gambling': 'Gambling',
      'pill-pmo': 'PMO',
      'pill-alcohol': 'Alcohol',
      'pill-drugs': 'Drugs',
      'val-title': 'Everything you need to stay strong',
      'val-sub': 'Simple tools that actually help — no guilt, no judgment, just support.',
      'v1-title': 'Streak Counter',
      'v1-desc': 'Watch your days grow. Every second counts — and you can see it live.',
      'v2-title': 'Money Saved',
      'v2-desc': "See exactly how much you've saved. Set a goal — that PS5 is getting closer.",
      'v3-title': 'SOS Craving',
      'v3-desc': 'One tap when the urge hits. Breathing guide, distraction, or talk to AI.',
      'v4-title': 'AI Companion',
      'v4-desc': 'A friend who never sleeps, never judges. Talk anytime — 2 AM included.',
      'phone-greet': 'Good morning,',
      'phone-streak-label': 'days strong',
      'phone-saved-label': 'Money saved',
      'phone-sos': "I'm struggling right now",
      'footer-tagline': '"The fight is against me, for me."'
    },
    id: {
      'hero-1': 'Lawannya',
      'hero-2': 'adalah aku',
      'hero-3': ',',
