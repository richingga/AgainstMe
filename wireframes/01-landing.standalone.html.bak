      'footer-tagline': '"Lawannya adalah aku, untuk aku."'
    }
  };

  let currentLang = 'en';

  function toggleLang() {
    currentLang = currentLang === 'en' ? 'id' : 'en';
    document.getElementById('langLabel').textContent = currentLang.toUpperCase();
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (translations[currentLang][key]) {
        if (el.tagName === 'BUTTON' && el.querySelector('svg')) {
          const svg = el.querySelector('svg').outerHTML;
          el.innerHTML = translations[currentLang][key] + ' ' + svg;
        } else {
          el.textContent = translations[currentLang][key];
        }
      }
    });
  }

  // Subtle streak pulse
  const streakEl = document.getElementById('streakDays');
  setInterval(() => {
    streakEl.style.transform = 'scale(1.05)';
    streakEl.style.transition = 'transform 0.3s ease';
    setTimeout(() => { streakEl.style.transform = 'scale(1)'; }, 300);
  }, 4000);
</script>

</body>
</html>
